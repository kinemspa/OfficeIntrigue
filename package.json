{
  "name": "officeintrigue",
  "version": "0.1.0",
  "description": "An asynchronous, text-based multiplayer social deduction game for Microsoft Teams, inspired by Among Us.",
  "main": "dist/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "test": "jest",
    "docs:serve": "node scripts/serve-openapi.js",
    "schema:validate": "node scripts/validate-schemas.js"
  },
  "keywords": ["teams", "bot", "game", "social-deduction", "among-us", "multiplayer"],
  "author": "Office Intrigue Contributors",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@azure/cosmos": "^4.6.0",
    "adaptivecards-templating": "^2.3.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "applicationinsights": "^3.12.0",
    "botbuilder": "^4.23.3",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "luxon": "^3.7.2",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.8.1",
    "@types/uuid": "^10.0.0",
    "@types/yamljs": "^0.2.34",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^9.37.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "swagger-jsdoc": "^6.2.8",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
